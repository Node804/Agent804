# Copy into a project as .editorconfig and merge with any existing configuration.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,jsonc,yml,yaml,js,jsx,mjs,cjs,ts,tsx,mts,cts,css,html}]
indent_size = 2

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.md]
# Markdown can use trailing spaces for hard line breaks.
trim_trailing_whitespace = false
